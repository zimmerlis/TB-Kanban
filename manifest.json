{
    "manifest_version": 3,
    "default_locale" : "en",
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "version": "0.1.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "tb-kanban@local",
            "strict_min_version": "153.0"
        }
    },
    "action": {
        "default_title": "Kanban",
        "default_icon": "images/tb-kanban_32x32.png",
        "allowed_spaces": []
    },
    "background": {
        "scripts": [
            "scripts/background.js"
        ],
        "type": "module"
    },
    "icons": {
        "32" : "images/tb-kanban_32x32.png",
        "16" : "images/tb-kanban_16x16.png"
    },
    "experiment_apis" : {
        "calendar_calendars" : {
            "schema" : "thunderbird/calendar/schema/calendar-calendars.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendar-calendars.js",
                "paths":  [ [ "calendar", "calendars"] ]
            }
        },
        "calendar_items" : {
            "schema" : "thunderbird/calendar/schema/calendar-items.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendar-items.js",
                "paths":  [ [ "calendar", "items"] ]
            }
        },
        "calendar_categories" : {
            "schema" : "thunderbird/calendar/schema/calendar-categories.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendar-categories.js",
                "paths":  [ [ "calendar", "categories"] ]
            }
        },
        "calendar_provider" : {
            "schema" : "thunderbird/calendar/schema/calendar-provider.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendar-provider.js",
                "events": ["startup"],
                "paths":  [ [ "calendar", "provider"] ]
            }
        },
        "calendarTaskView" : {
            "schema" : "thunderbird/calendar/schema/calendar-task-view.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendar-task-view.js",
                "events": ["startup"],
                "paths":  [ [ "calendarTaskView"] ]
            }
        },
        "calendarItemAction" : {
            "schema" : "thunderbird/calendar/schema/calendarItemAction.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendarItemAction.js",
                "events": ["startup"],
                "paths":  [ [ "calendarItemAction"] ]
            }
        },
        "calendarItemDetails" : {
            "schema" : "thunderbird/calendar/schema/calendarItemDetails.json",
            "parent" : {
                "scopes" : ["addon_parent"],
                "script": "thunderbird/calendar/parent/ext-calendarItemDetails.js",
                "events": ["startup"],
                "paths":  [ [ "calendarItemDetails"] ]
            }
        }
    },
    "permissions": [
        "tabs",
        "contextualIdentities",
        "menus",
        "menus.overrideContext",
        "cookies",
        "storage",
        "theme"
      ]


}
